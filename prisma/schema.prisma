generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  category  String   // e.g., "Kebutuhan", "Kegiatan", "Laporan"
  content   String
  quote     String?
  imageUrl  String   // public Cloudflare R2 URL
  imageKey  String?  // optional R2 object key / path
  createdAt DateTime @default(now())
}

model Gallery {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String   // public Cloudflare R2 URL
  imageKey    String?  // optional R2 object key / path
  albumId     Int?     // Optional connection to an album
  album       Album?   @relation(fields: [albumId], references: [id])
  createdAt   DateTime @default(now())
}

model Album {
  id          Int       @id @default(autoincrement())
  title       String    // e.g. "Ramadhan 2024", "Pendidikan"
  description String?
  coverImage  String?   // URL for the highlight cover
  year        Int       // Grouping year (e.g. 2026)
  photos      Gallery[]
  createdAt   DateTime  @default(now())
}

model Settings {
  id            Int      @id @default(1)
  adminUsername String   @default("admin")
  adminSecret   String   
  recoveryEmail String?
  updatedAt     DateTime @updatedAt
}